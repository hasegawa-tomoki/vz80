; SPDX-License-Identifier: BSD-3-Clause
; WS2812 driver, 800 kbit/s: each bit is 10 PIO cycles at 8 MHz.
; 0 = high 2 / low 8, 1 = high 7 / low 3 (T1=2, T2=5, T3=3).
.program ws2812
.side_set 1
.wrap_target
bitloop:
    out x, 1        side 0 [2]   ; low tail (T3), fetch next bit
    jmp !x do_zero    side 1 [1]   ; high T1
    jmp bitloop     side 1 [4]   ; '1': stay high T2
do_zero:
    nop             side 0 [4]   ; '0': go low for T2
.wrap
